{
  "name": "pebble-browser-emulator",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run build:wasm && npm run build:web",
    "watch": "ng build --watch --configuration development",
    "dev": "ng serve --host 0.0.0.0",
    "build:web": "ng build && node scripts/publish-notices.mjs",
    "build:wasm": "node scripts/build-wasm.mjs && node scripts/collect-notices.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build:wasm && npm test && npm run build:web",
    "install:ci": "npm ci"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "esbuild-wasm": "0.28.2",
    "fflate": "^0.8.3",
    "quickjs-emscripten": "^0.32.0",
    "rxjs": "~7.8.0",
    "three": "^0.186.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@types/three": "^0.186.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "type": "module"
}
