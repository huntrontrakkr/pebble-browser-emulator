{
  "name": "pebble-browser-emulator",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run build:wasm && npm run build:phone && npm run build:web",
    "watch": "ng build --watch --configuration development",
    "dev": "ng serve --host 0.0.0.0",
    "dev:resources": "node services/resources/server.mjs",
    "build:web": "npm run build:checkpoints && ng build && node scripts/publish-notices.mjs && node scripts/write-service-config.mjs dist/client/service-config.json && node scripts/stamp-build.mjs && node scripts/build-pwa.mjs",
    "build:checkpoints": "node scripts/build-startup-checkpoints.mjs",
    "firmware:check": "node scripts/check-firmware-releases.mjs",
    "firmware:audit-physical": "node scripts/audit-sifli-images.mjs",
    "fidelity:capture": "node scripts/verify-fidelity-run.mjs",
    "fidelity:physical-reset": "node scripts/verify-sifli-execution.mjs",
    "fidelity:audio-reference": "node scripts/verify-audio-reference.mjs",
    "fidelity:compare": "node scripts/verify-fidelity-run.mjs --compare",
    "build:wasm": "node scripts/build-wasm.mjs && node scripts/collect-notices.mjs",
    "build:phone": "node scripts/build-phone.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/verify-browser-workflow.mjs",
    "check": "npm run build:wasm && npm run build:phone && npm test && npm run build:web",
    "install:ci": "npm ci",
    "compatibility:corpus": "node scripts/compatibility/corpus.mjs",
    "compatibility:benchmark": "node scripts/compatibility/benchmark.mjs",
    "compatibility:capture": "node scripts/compatibility/supervisor.mjs",
    "compatibility:evaluate": "node scripts/compatibility/evaluate.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "esbuild-wasm": "0.28.2",
    "fflate": "^0.8.3",
    "quickjs-emscripten": "^0.32.0",
    "rxjs": "~7.8.0",
    "three": "^0.186.0",
    "tslib": "^2.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@types/three": "^0.186.0",
    "playwright": "1.63.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "type": "module"
}
